{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"singleQuote": true,
	"trailingComma": "es5",
	"useTabs": true,
	"semi": false,
	"printWidth": 80,
	"sortImports": false,
	"sortPackageJson": false,
	"ignorePatterns": [
		"node_modules",
		"dist",
		"coverage",
		"test/attachments",
		"pnpm-lock.yaml",
		"yarn.lock",
		"package-lock.json",
		".nono.json"
	]
}
