{
	"name": "emailjs",
	"description": "send text/html emails and attachments (files, streams and strings) from node.js to any smtp server",
	"version": "5.0.4",
	"author": "eleith",
	"contributors": [
		"izuzak",
		"Hiverness",
		"mscdex",
		"jimmybergman",
		"zackschuster"
	],
	"repository": {
		"type": "git",
		"url": "http://github.com/eleith/emailjs.git"
	},
	"type": "module",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"@vitest/coverage-v8": "4.1.12",
		"mailparser": "3.12.4",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"smtp-server": "3.21.1",
		"typescript": "^5.7.2",
		"vitest": "4.1.12"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"overrides": {
		"vite": "^7.3.7"
	},
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --deny-warnings src",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "npm run build"
	},
	"license": "MIT"
}
